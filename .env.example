# Copy to .env and fill in.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Model driving the agent (Mode A). Defaults to claude-opus-4-8.
ANTHROPIC_MODEL=claude-opus-4-8

# Max output tokens per turn.
MAX_TOKENS=4096

# Adaptive thinking: "on" (default) or "off".
THINKING=on

# Safety valve: hard cap on agent loop iterations per request.
MAX_ITERATIONS=12

# SQLite database file (created + seeded on first boot).
DATABASE_PATH=./data/useradmin.db

# HTTP port.
PORT=3000

# Product 2 (SupportDesk) — feature flag for the refund autonomy policy.
# "code_enforced" (default) rejects refunds that violate REFUND_POLICY in
# code; "prompt_only" states the same policy in the system prompt only, with
# no code-level check, for the paired adversarial-ticket comparison.
REFUND_POLICY_ENFORCEMENT=code_enforced

# Product 2 — context-management (compaction) experiment toggles. Off by
# default; see agent.service.ts.
COMPACTION_ENABLED=off
COMPACTION_TURN_THRESHOLD=20
COMPACTION_TOKEN_THRESHOLD=60000
COMPACTION_KEEP_RECENT_TURNS=4
